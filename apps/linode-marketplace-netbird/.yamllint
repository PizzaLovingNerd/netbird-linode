---
extends: default

ignore: |
  .cache/*
  env/*

rules:
  braces:
    max-spaces-inside: 1
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  document-start: enable
  empty-lines:
    max: 2
    max-start: 0
    max-end: 1
  line-length:
    max: 120
    level: warning
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
